separator_block_width=15
markup=none

[saying]
command=echo "彻底的唯物主义是无所畏惧"
interval=once

[network]
command=~/.config/i3blocks/network.sh
interval=once
signal=2

[memory]
command=~/.config/i3blocks/memory.sh
interval=10

[cpu]
command=~/.config/i3blocks/cpu.sh
interval=10

[volume]
command=~/.config/i3blocks/volume.sh
interval=once
signal=1

[time]
command=date '+%H:%M:%S %Y/%m/%d'
interval=5

