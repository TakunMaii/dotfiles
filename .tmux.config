set -g mouse on

# 状态栏背景蓝色，前景白色（按需改）
set -g status-bg colour4
set -g status-fg colour15

# 左侧和右侧的样式也统一一下，避免有的模块还是默认色
set -g status-left-style fg=colour15,bg=colour4
set -g status-right-style fg=colour15,bg=colour4

# 当前窗口标签高亮（更深的蓝 / 反色，方便区分）
set -g window-status-current-style fg=colour0,bg=colour12,bold
set -g window-status-style fg=colour15,bg=colour4

# 取消默认绑定（可选，干净一点）
unbind h
unbind j
unbind k
unbind l

# Ctrl+b h → 左 pane
bind h select-pane -L
# Ctrl+b j → 下 pane
bind j select-pane -D
# Ctrl+b k → 上 pane
bind k select-pane -U
# Ctrl+b l → 右 pane
bind l select-pane -R

bind -r H resize-pane -L 2
bind -r J resize-pane -D 2
bind -r K resize-pane -U 2
bind -r L resize-pane -R 2
